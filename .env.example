NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:55432/luma_store
DATABASE_SSL=false
STORAGE_DIR=./storage
MAX_ARTIFACT_SIZE_BYTES=8589934592
MIN_VERSIONS_TO_KEEP=5
SESSION_TTL_HOURS=12
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-another-32-character-secret

# Kyros — application SSO standard avec callback /auth/callback
KYROS_BASE_URL=http://localhost:3003
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_JWT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:luma-store
KYROS_SCOPE=profile email
KYROS_SSO_VERSION=v3
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard
